---
interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  count?: number;
}
const { eyebrow, title, desc, count } = Astro.props;
---

<header class="mx-auto max-w-6xl px-5 pt-12 pb-8">
  {
    eyebrow && (
      <p class="text-xs font-bold uppercase tracking-[0.2em]" style="color:var(--brand)">
        {eyebrow}
      </p>
    )
  }
  <div class="mt-2 flex flex-wrap items-baseline gap-3">
    <h1 class="text-4xl font-black tracking-tight sm:text-5xl">{title}</h1>
    {
      count !== undefined && (
        <span class="text-2xl font-black tabular-nums" style="color:var(--muted)">
          {count}
        </span>
      )
    }
  </div>
  {desc && <p class="mt-3 max-w-2xl" style="color:var(--muted)">{desc}</p>}
</header>
