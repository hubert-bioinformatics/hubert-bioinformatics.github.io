---
interface Props {
  current: 'a' | 'b' | 'c';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;

const variants = [
  { id: 'a', label: 'A · Editorial', desc: '타이포 중심 · 절제' },
  { id: 'b', label: 'B · Bold', desc: '카드 · 컬러 · 역동' },
  { id: 'c', label: 'C · Terminal', desc: '다크 · 고밀도 · 기술적' },
] as const;
---

<div
  style="position:sticky;top:0;z-index:50;background:#111;color:#fff;font-family:ui-monospace,monospace;"
>
  <div
    style="max-width:72rem;margin:0 auto;padding:.5rem 1rem;display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;"
  >
    <span style="font-size:.7rem;opacity:.55;letter-spacing:.1em;">시안 비교</span>
    {
      variants.map((v) => (
        <a
          href={`${base}/preview/${v.id}`}
          style={`font-size:.75rem;padding:.3rem .6rem;border-radius:.35rem;text-decoration:none;${
            v.id === current
              ? 'background:#fff;color:#111;font-weight:600;'
              : 'background:#2a2a2a;color:#bbb;'
          }`}
        >
          {v.label}
          <span style="opacity:.6;margin-left:.4rem;font-weight:400;">{v.desc}</span>
        </a>
      ))
    }
  </div>
</div>
