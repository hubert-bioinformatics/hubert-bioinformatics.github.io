---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getMoments, fmtDate } from '../../lib/content';
import { toEmbed } from '../../lib/video';

const moments = await getMoments();
// 사진 그리드와 영상 섹션이 겹치지 않게 kind 로 나눈다
const photos = moments.filter((m) => m.data.kind !== 'video' && m.data.image);
const videos = moments.filter((m) => m.data.kind === 'video');
---

<Base title="Moment" description="사진과 영상">
  <PageHeader
    eyebrow="Moment"
    title="Moment"
    desc="렌즈로 남긴 순간들"
    count={moments.length}
  />

  <div class="mx-auto max-w-6xl px-5 pb-16">
    {
      moments.length === 0 ? (
        <EmptyState
          title="아직 사진이 없습니다"
          desc="사진과 마크다운을 추가하면 갤러리에 자동으로 나타납니다."
          hint="src/content/moment/my-photo.md"
        />
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {photos.map((m, i) => (
            <figure
              class="card card-hover group cursor-zoom-in overflow-hidden"
              data-lightbox={i}
            >
              <div class="overflow-hidden">
                <Image
                  src={m.data.image!}
                  alt={m.data.title}
                  widths={[400, 800, 1600]}
                  sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, 33vw"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <figcaption class="p-4">
                <div class="font-semibold">{m.data.title}</div>
                {m.data.location && (
                  <div class="mt-1 text-xs" style="color:var(--muted)">
                    {m.data.location}
                  </div>
                )}
                <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs" style="color:var(--muted)">
                  {m.data.camera && <span>{m.data.camera}</span>}
                  {m.data.lens && <span>{m.data.lens}</span>}
                  {m.data.aperture && <span>{m.data.aperture}</span>}
                  {m.data.shutter && <span>{m.data.shutter}</span>}
                  {m.data.iso && <span>ISO {m.data.iso}</span>}
                  {m.data.shotAt && <span>{fmtDate(m.data.shotAt)}</span>}
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      videos.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-black tracking-tight">Video</h2>
          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            {videos.map((m) => {
              const embed = toEmbed(m.data.videoUrl);
              return (
                <figure class="card overflow-hidden">
                  {embed ? (
                    <div class="aspect-video w-full">
                      <iframe
                        src={embed.src}
                        title={m.data.title}
                        class="h-full w-full"
                        loading="lazy"
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"
                        frameborder="0"
                      />
                    </div>
                  ) : m.data.image ? (
                    /* 아직 영상 링크가 없는 항목 — 썸네일만 보여준다 */
                    <Image
                      src={m.data.image}
                      alt={m.data.title}
                      widths={[400, 800]}
                      sizes="(max-width:1024px) 100vw, 50vw"
                      class="aspect-video w-full object-cover"
                    />
                  ) : null}

                  <figcaption class="p-4">
                    <div class="flex items-baseline gap-2">
                      <span class="font-semibold">{m.data.title}</span>
                      {!embed && (
                        <span
                          class="chip"
                          style="background:var(--line);color:var(--muted)"
                          title="Keystatic 의 Moment 항목에서 영상 링크를 넣으면 플레이어가 나옵니다"
                        >
                          링크 없음
                        </span>
                      )}
                    </div>
                    {m.data.location && (
                      <div class="mt-1 text-xs" style="color:var(--muted)">
                        {m.data.location}
                      </div>
                    )}
                    {m.data.shotAt && (
                      <div class="mt-1 text-xs" style="color:var(--muted)">
                        {fmtDate(m.data.shotAt)}
                      </div>
                    )}
                    {!embed && m.data.videoUrl && (
                      <a
                        href={m.data.videoUrl}
                        class="mt-2 inline-block text-xs font-semibold"
                        style="color:var(--brand)"
                      >
                        영상 보기 →
                      </a>
                    )}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      )
    }
  </div>

  <!-- 라이트박스 -->
  <div
    id="lb"
    class="fixed inset-0 z-50 hidden place-items-center bg-black/90 p-4"
    role="dialog"
    aria-modal="true"
  >
    <button
      id="lb-close"
      class="absolute top-4 right-4 rounded-lg bg-white/15 px-3 py-1.5 text-sm text-white backdrop-blur"
      aria-label="닫기"
    >
      닫기 ✕
    </button>
    <img id="lb-img" class="max-h-[88vh] max-w-full object-contain" alt="" />
    <p id="lb-cap" class="absolute bottom-5 left-0 right-0 text-center text-sm text-white/80"></p>
  </div>
</Base>

<script>
  function initLightbox() {
    const lb = document.getElementById('lb');
    const img = document.getElementById('lb-img');
    const cap = document.getElementById('lb-cap');
    const closeBtn = document.getElementById('lb-close');
    if (!lb || !img) return;

    const open = (src, caption) => {
      img.src = src;
      if (cap) cap.textContent = caption;
      lb.classList.remove('hidden');
      lb.style.display = 'grid';
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.add('hidden');
      lb.style.display = 'none';
      document.body.style.overflow = '';
      img.src = '';
    };

    document.querySelectorAll('[data-lightbox]').forEach((fig) => {
      fig.addEventListener('click', () => {
        const el = fig.querySelector('img');
        if (!el) return;
        const title = fig.querySelector('figcaption div')?.textContent ?? '';
        open(el.currentSrc || el.src, title);
      });
    });

    closeBtn?.addEventListener('click', close);
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
