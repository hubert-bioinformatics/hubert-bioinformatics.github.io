---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Reading from '../../layouts/Reading.astro';
import Comments from '../../components/Comments.astro';
import { NOTE_CATEGORY_LABEL } from '../../lib/site';
import { url, catColor } from '../../lib/nav';
import { getNotes, seriesNeighbors, fmtDate } from '../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, all: notes },
  }));
};

/**
 * 정적 빌드에서는 getStaticPaths 가 props 를 채워 주지만, 관리자 빌드는
 * output:'server' 라 그게 무시되고 props 가 빈 채로 SSR 된다.
 * 한글 슬러그가 섞여 있어 그때는 400 으로 떨어졌다. 자세한 배경은
 * radar/[...slug].astro 의 같은 자리 주석 참고.
 */
let note = Astro.props.note;
let all = Astro.props.all;
if (!note) {
  all = await getNotes();
  const slug = Astro.params.slug;
  note = all.find((entry) => entry.id === slug);
  if (!note) return new Response(null, { status: 404 });
}

const { Content, headings } = await render(note);
const { siblings, prev, next } = seriesNeighbors(note, all);
const c = catColor(note.data.category);
const toc = headings.filter((h) => h.depth <= 3);
---

<Reading
  title={note.data.title}
  description={note.data.summary}
  backHref="/notes"
  backLabel="Notes"
>
  <header slot="header" class="mt-6">
    <span
      class="chip"
      style={`background:color-mix(in srgb, ${c} 12%, transparent);color:${c}`}
    >
      {NOTE_CATEGORY_LABEL[note.data.category] ?? note.data.category}
    </span>

    <h1 class="mt-4 text-3xl font-black leading-tight tracking-tight sm:text-4xl">
      {note.data.title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm" style="color:var(--muted)">
      <time datetime={note.data.date.toISOString()}>{fmtDate(note.data.date)}</time>
      {
        note.data.series && (
          <>
            <span>·</span>
            <span>
              {note.data.series}
              {note.data.seriesOrder ? ` ${note.data.seriesOrder}/${siblings.length}편` : ''}
            </span>
          </>
        )
      }
    </div>

    {
      note.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {note.data.tags.map((t) => (
            <span class="rounded px-1.5 py-0.5 text-xs" style="background:var(--line);color:var(--muted)">
              {t}
            </span>
          ))}
        </div>
      )
    }

    {
      toc.length > 2 && (
        <nav class="card mt-8 p-4 text-sm">
          <div class="mb-2 font-bold">목차</div>
          <ul class="space-y-1">
            {toc.map((h) => (
              <li style={`padding-left:${(h.depth - 2) * 14}px`}>
                <a href={`#${h.slug}`} class="hover:underline" style="color:var(--muted)">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </header>

  <Content />

  <footer slot="footer" class="mt-16">
    {
      (prev || next) && (
        <nav class="grid gap-3 sm:grid-cols-2">
          {prev ? (
            <a href={url(`/notes/${prev.id}`)} class="card card-hover p-4">
              <div class="text-xs" style="color:var(--muted)">← 이전 편</div>
              <div class="mt-1 font-semibold">{prev.data.title}</div>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={url(`/notes/${next.id}`)} class="card card-hover p-4 sm:text-right">
              <div class="text-xs" style="color:var(--muted)">다음 편 →</div>
              <div class="mt-1 font-semibold">{next.data.title}</div>
            </a>
          )}
        </nav>
      )
    }

    {
      siblings.length > 1 && (
        <details class="card mt-6 p-4">
          <summary class="cursor-pointer font-bold">
            {note.data.series} 전체 {siblings.length}편
          </summary>
          <ol class="mt-3 space-y-1.5 text-sm">
            {siblings.map((s) => (
              <li class="flex gap-2">
                <span class="tabular-nums" style="color:var(--muted)">
                  {s.data.seriesOrder ?? '·'}
                </span>
                {s.id === note.id ? (
                  <span class="font-semibold">{s.data.title}</span>
                ) : (
                  <a href={url(`/notes/${s.id}`)} class="hover:underline">
                    {s.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <Comments />
  </footer>
</Reading>
