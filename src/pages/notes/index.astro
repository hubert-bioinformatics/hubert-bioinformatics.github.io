---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NoteCard from '../../components/NoteCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { NOTE_CATEGORY_LABEL } from '../../lib/site';
import { url, catColor } from '../../lib/nav';
import { getNotes, countBy, groupSeries } from '../../lib/content';

const notes = await getNotes();
const cats = countBy(notes, (n) => n.data.category);
const series = groupSeries(notes);
---

<Base title="Notes" description="기술 노트 · 분석 기록">
  <PageHeader
    eyebrow="Notes"
    title="기술 노트"
    desc="NGS 분석, 프로그래밍, 통계, 분자생물학 학습 기록"
    count={notes.length}
  />

  <div class="mx-auto max-w-6xl px-5 pb-16">
    {
      notes.length === 0 ? (
        <EmptyState
          title="아직 글이 없습니다"
          desc="마크다운 파일을 추가하면 이 목록에 자동으로 나타납니다."
          hint="src/content/notes/my-post.md"
        />
      ) : (
        <>
          <div class="flex flex-wrap gap-2" id="filters">
            <button
              class="chip filter-btn"
              data-cat="all"
              aria-pressed="true"
              style="background:var(--ink);color:var(--bg)"
            >
              전체 {notes.length}
            </button>
            {cats.map(([c, n]) => (
              <button
                class="chip filter-btn"
                data-cat={c}
                aria-pressed="false"
                style={`background:color-mix(in srgb, ${catColor(c)} 12%, transparent);color:${catColor(c)}`}
              >
                {NOTE_CATEGORY_LABEL[c] ?? c} {n}
              </button>
            ))}
          </div>

          <div id="note-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {notes.map((n) => (
              <div
                class="note-item"
                data-cat={n.data.category}
                data-series={n.data.series ?? ''}
              >
                <NoteCard note={n} />
              </div>
            ))}
          </div>

          <p id="no-result" class="hidden py-16 text-center text-sm" style="color:var(--muted)">
            해당하는 글이 없습니다.
          </p>

          {series.length > 0 && (
            <section class="mt-20">
              <h2 class="text-2xl font-black tracking-tight">Series</h2>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {series.map((s) => (
                  <details class="card p-4">
                    <summary class="flex cursor-pointer items-center justify-between font-bold">
                      <span>{s.name}</span>
                      <span class="text-sm tabular-nums" style="color:var(--muted)">
                        {s.items.length}편
                      </span>
                    </summary>
                    <ol class="mt-3 space-y-1.5 text-sm">
                      {s.items.map((n) => (
                        <li class="flex gap-2">
                          <span class="tabular-nums" style="color:var(--muted)">
                            {n.data.seriesOrder ?? '·'}
                          </span>
                          <a href={url(`/notes/${n.id}`)} class="hover:underline">
                            {n.data.title}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </details>
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </div>
</Base>

<script>
  function initFilters() {
    const grid = document.getElementById('note-grid');
    if (!grid) return;
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.note-item');
    const noResult = document.getElementById('no-result');

    const apply = (cat, seriesName) => {
      let shown = 0;
      items.forEach((el) => {
        const okCat = cat === 'all' || el.dataset.cat === cat;
        const okSeries = !seriesName || el.dataset.series === seriesName;
        const show = okCat && okSeries;
        el.hidden = !show;
        if (show) shown++;
      });
      if (noResult) noResult.classList.toggle('hidden', shown > 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        apply(btn.dataset.cat ?? 'all');
        history.replaceState(
          null,
          '',
          btn.dataset.cat === 'all' ? location.pathname : `?category=${btn.dataset.cat}`,
        );
      });
    });

    // 홈에서 ?category= / ?series= 로 들어온 경우 초기 적용
    const q = new URLSearchParams(location.search);
    const cat = q.get('category');
    const ser = q.get('series');
    if (cat || ser) apply(cat ?? 'all', ser ?? undefined);
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
