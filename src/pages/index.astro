---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { site, NOTE_CATEGORY_LABEL } from '../lib/site';
import { url, catColor } from '../lib/nav';
import {
  getNotes, getMoments, getCredentials, getRadar, getProjects, getCurrentRole,
  countBy, groupSeries,
} from '../lib/content';

const [notes, moments, creds, radar, projects, role] = await Promise.all([
  getNotes(), getMoments(), getCredentials(), getRadar(), getProjects(), getCurrentRole(),
]);

const cats = countBy(notes, (n) => n.data.category);
const series = groupSeries(notes).slice(0, 6);
const providers = countBy(creds, (c) => c.data.provider);

const stats = [
  { label: 'Notes', n: notes.length, href: '/notes' },
  { label: 'Radar', n: radar.length, href: '/radar' },
  { label: 'Courses', n: creds.length, href: '/portfolio' },
  { label: 'Moments', n: moments.length, href: '/moment' },
];
---

<Base transparentHeader>
  <!-- HERO -->
  <section class="hero-grad relative -mt-[3.75rem] overflow-hidden text-white">
    <div class="mx-auto max-w-6xl px-5 pt-32 pb-20 sm:pt-40 sm:pb-28">
      <span class="chip bg-white/20 backdrop-blur">{site.tagline}</span>
      <h1 class="mt-6 text-5xl font-black leading-[1.05] tracking-tight sm:text-7xl">
        {site.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/90">{site.intro}</p>
      <p class="mt-8 text-sm text-white/70">
        {site.name}
        {
          role && (
            <>
              {' · '}
              {role.data.title} @ {role.data.org}
              {role.data.team && <> · {role.data.teamRole || 'Member'}, {role.data.team}</>}
            </>
          )
        }
      </p>

      <div class="mt-12 flex flex-wrap gap-3">
        {
          stats.map((s) => (
            <a
              href={url(s.href)}
              class="rounded-2xl bg-white/15 px-6 py-4 backdrop-blur transition-colors hover:bg-white/25"
            >
              <div class="text-3xl font-black tabular-nums">{s.n}</div>
              <div class="text-xs uppercase tracking-widest text-white/75">{s.label}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 카테고리 스트립 -->
  {
    cats.length > 0 && (
      <div class="border-y" style="border-color:var(--line)">
        <div class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-5 py-4">
          {cats.map(([c, n]) => (
            <a
              href={url(`/notes?category=${c}`)}
              class="text-sm font-semibold"
              style={`color:${catColor(c)}`}
            >
              {NOTE_CATEGORY_LABEL[c] ?? c}
              <span class="ml-1 tabular-nums" style="color:var(--muted)">{n}</span>
            </a>
          ))}
        </div>
      </div>
    )
  }

  <div class="mx-auto max-w-6xl px-5 py-16">
    <!-- 최근 글 -->
    <div class="flex items-end justify-between">
      <h2 class="text-3xl font-black tracking-tight">Recent Notes</h2>
      <a href={url('/notes')} class="text-sm font-semibold" style="color:var(--muted)">
        전체 보기 →
      </a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {notes.slice(0, 6).map((n) => <NoteCard note={n} />)}
    </div>

    <!-- 최근 Radar (있을 때만) -->
    {
      radar.length > 0 && (
        <>
          <div class="mt-20 flex items-end justify-between">
            <h2 class="text-3xl font-black tracking-tight">Radar</h2>
            <a href={url('/radar')} class="text-sm font-semibold" style="color:var(--muted)">
              전체 보기 →
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {radar.slice(0, 3).map((r) => (
              <a href={url(`/radar/${r.id}`)} class="card card-hover block p-6">
                <span
                  class="chip"
                  style="background:color-mix(in srgb, var(--brand) 12%, transparent);color:var(--brand)"
                >
                  {r.data.kind === 'paper' ? 'Paper' : 'News'}
                </span>
                <h3 class="mt-4 font-bold leading-snug">{r.data.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm" style="color:var(--muted)">
                  {r.data.summary}
                </p>
              </a>
            ))}
          </div>
        </>
      )
    }

    <!-- 시리즈 -->
    {
      series.length > 0 && (
        <>
          <h2 class="mt-20 text-3xl font-black tracking-tight">Series</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {series.map((s) => (
              <a
                href={url(`/notes?series=${encodeURIComponent(s.name)}`)}
                class="card card-hover p-5"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-bold">{s.name}</h3>
                  <span
                    class="shrink-0 text-sm font-black tabular-nums"
                    style="color:var(--muted)"
                  >
                    {s.items.length}
                  </span>
                </div>
                <div class="mt-3 flex gap-1">
                  {s.items.slice(0, 12).map(() => (
                    <span class="h-1.5 flex-1 rounded-full" style="background:var(--line)" />
                  ))}
                </div>
              </a>
            ))}
          </div>
        </>
      )
    }

    <!-- 프로젝트 (있을 때만) -->
    {
      projects.length > 0 && (
        <>
          <h2 class="mt-20 text-3xl font-black tracking-tight">Projects</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {projects.slice(0, 4).map((p) => (
              <a href={url('/portfolio')} class="card card-hover block p-6">
                <h3 class="font-bold">{p.data.title}</h3>
                <p class="mt-2 text-sm" style="color:var(--muted)">
                  {p.data.summary}
                </p>
              </a>
            ))}
          </div>
        </>
      )
    }

    <!-- 이수 -->
    {
      providers.length > 0 && (
        <>
          <div class="mt-20 flex items-end justify-between">
            <h2 class="text-3xl font-black tracking-tight">Coursework</h2>
            <a href={url('/portfolio')} class="text-sm font-semibold" style="color:var(--muted)">
              전체 보기 →
            </a>
          </div>
          <p class="mt-2" style="color:var(--muted)">
            {providers.length}개 기관에서 {creds.length}개 과정 이수
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {providers.map(([p, n]) => (
              <div class="card flex items-center justify-between p-5">
                <span class="font-bold">{p}</span>
                <span class="text-2xl font-black tabular-nums" style="color:var(--muted)">
                  {n}
                </span>
              </div>
            ))}
          </div>
        </>
      )
    }

    <!-- 사진 (맨 아래) -->
    {
      moments.length > 0 && (
        <>
          <div class="mt-20 flex items-end justify-between">
            <h2 class="text-3xl font-black tracking-tight">Moment</h2>
            <a href={url('/moment')} class="text-sm font-semibold" style="color:var(--muted)">
              전체 보기 →
            </a>
          </div>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {moments
              .filter((m) => m.data.image)
              .slice(0, 6)
              .map((m) => (
                <a href={url('/moment')} class="card card-hover group block overflow-hidden">
                  <div class="overflow-hidden">
                    <Image
                      src={m.data.image!}
                      alt={m.data.title}
                      widths={[400, 800]}
                      sizes="(max-width:640px) 100vw, 33vw"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <div class="p-4">
                    <div class="font-semibold">{m.data.title}</div>
                    <div class="mt-1 text-xs" style="color:var(--muted)">
                      {m.data.location}
                    </div>
                  </div>
                </a>
              ))}
          </div>
        </>
      )
    }
  </div>
</Base>
