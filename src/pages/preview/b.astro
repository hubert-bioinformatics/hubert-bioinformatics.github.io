---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../../styles/global.css';
import { site, NOTE_CATEGORY_LABEL } from '../../lib/site';
import {
  getNotes, getMoments, getCredentials, countBy, groupSeries, fmtDate,
} from '../../lib/content';
import VariantBar from '../../components/VariantBar.astro';

const notes = await getNotes();
const moments = await getMoments();
const creds = await getCredentials();
const cats = countBy(notes, (n) => n.data.category);
const series = groupSeries(notes).slice(0, 6);
const providers = countBy(creds, (c) => c.data.provider);

const CAT_COLOR: Record<string, string> = {
  bioinformatics: '#0ea5e9',
  programming: '#8b5cf6',
  biology: '#10b981',
  statistics: '#f59e0b',
  'ml-data': '#ef4444',
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>B · Bold — {site.title}</title>
    <ClientRouter />
    <style>
      .bd { --bg:#ffffff; --card:#ffffff; --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; }
      @media (prefers-color-scheme: dark) {
        .bd { --bg:#0b1120; --card:#131c31; --ink:#f1f5f9; --muted:#94a3b8; --line:#1e293b; }
      }
      .bd { background: var(--bg); color: var(--ink); }
      .card {
        background: var(--card); border:1px solid var(--line); border-radius:1rem;
        transition: transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s;
      }
      .card:hover { transform: translateY(-5px); box-shadow: 0 18px 40px -18px rgba(2,8,23,.35); }
      .hero-grad {
        background: radial-gradient(120% 120% at 0% 0%, #6366f1 0%, #0ea5e9 45%, #06b6d4 100%);
      }
      .chip { border-radius:999px; font-size:.7rem; padding:.2rem .6rem; font-weight:600; }
      .marquee { animation: slide 32s linear infinite; }
      @keyframes slide { from{transform:translateX(0)} to{transform:translateX(-50%)} }
      @media (prefers-reduced-motion: reduce) { .marquee { animation:none } .card:hover{transform:none} }
    </style>
  </head>
  <body class="bd">
    <VariantBar current="b" />

    <!-- HERO -->
    <section class="hero-grad relative overflow-hidden text-white">
      <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
        <span class="chip bg-white/20 backdrop-blur">{site.tagline}</span>
        <h1 class="mt-6 text-5xl font-black leading-[1.05] tracking-tight sm:text-7xl">
          {site.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/90">{site.intro}</p>
        <p class="mt-8 text-sm text-white/70">
          {site.name} · {site.role} @ {site.org} · {site.teamRole}, {site.team}
        </p>

        <div class="mt-12 flex flex-wrap gap-3">
          {[['Notes', notes.length], ['Courses', creds.length], ['Moments', moments.length]].map(
            ([l, n]) => (
              <div class="rounded-2xl bg-white/15 px-6 py-4 backdrop-blur">
                <div class="text-3xl font-black tabular-nums">{n}</div>
                <div class="text-xs uppercase tracking-widest text-white/75">{l}</div>
              </div>
            ),
          )}
        </div>
      </div>
    </section>

    <!-- 카테고리 마퀴 -->
    <div class="overflow-hidden border-y py-3" style="border-color:var(--line)">
      <div class="marquee flex w-max gap-8 whitespace-nowrap">
        {[...cats, ...cats, ...cats, ...cats].map(([c, n]) => (
          <span class="text-sm font-semibold" style={`color:${CAT_COLOR[c]}`}>
            {NOTE_CATEGORY_LABEL[c]} <span style="color:var(--muted)">{n}</span>
          </span>
        ))}
      </div>
    </div>

    <main class="mx-auto max-w-6xl px-6 py-16">
      <!-- 최근 글 카드 -->
      <div class="flex items-end justify-between">
        <h2 class="text-3xl font-black tracking-tight">Recent Notes</h2>
        <a href="#" class="text-sm font-semibold" style="color:var(--muted)">전체 보기 →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {notes.slice(0, 6).map((n) => (
          <a href="#" class="card block p-6">
            <span class="chip" style={`background:${CAT_COLOR[n.data.category]}1a;color:${CAT_COLOR[n.data.category]}`}>
              {NOTE_CATEGORY_LABEL[n.data.category]}
            </span>
            <h3 class="mt-4 text-lg font-bold leading-snug">{n.data.title}</h3>
            <div class="mt-4 flex items-center gap-2 text-xs" style="color:var(--muted)">
              <time>{fmtDate(n.data.date)}</time>
              {n.data.series && <><span>·</span><span>{n.data.series} #{n.data.seriesOrder}</span></>}
            </div>
          </a>
        ))}
      </div>

      <!-- 시리즈 -->
      <h2 class="mt-20 text-3xl font-black tracking-tight">Series</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {series.map((s) => (
          <div class="card p-5">
            <div class="flex items-baseline justify-between">
              <h3 class="font-bold">{s.name}</h3>
              <span class="text-sm font-black tabular-nums" style="color:var(--muted)">
                {s.items.length}
              </span>
            </div>
            <div class="mt-3 flex gap-1">
              {s.items.slice(0, 12).map(() => (
                <span class="h-1.5 flex-1 rounded-full" style="background:var(--line)" />
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- 이수 -->
      <h2 class="mt-20 text-3xl font-black tracking-tight">Coursework</h2>
      <p class="mt-2" style="color:var(--muted)">
        {providers.length}개 기관에서 {creds.length}개 과정 이수
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {providers.map(([p, n]) => (
          <div class="card flex items-center justify-between p-5">
            <span class="font-bold">{p}</span>
            <span class="text-2xl font-black tabular-nums" style="color:var(--muted)">{n}</span>
          </div>
        ))}
      </div>

      <!-- 사진 (맨 아래) -->
      <h2 class="mt-20 text-3xl font-black tracking-tight">Moment</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {moments.filter((m) => m.data.image).slice(0, 6).map((m) => (
          <figure class="card group overflow-hidden">
            <div class="overflow-hidden">
              <Image
                src={m.data.image!}
                alt={m.data.title}
                widths={[400, 800]}
                sizes="(max-width:640px) 100vw, 33vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <figcaption class="p-4">
              <div class="font-semibold">{m.data.title}</div>
              <div class="mt-1 text-xs" style="color:var(--muted)">
                {m.data.location}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </main>

    <footer class="border-t py-10 text-center text-sm" style="border-color:var(--line);color:var(--muted)">
      © {new Date().getFullYear()} {site.name}
    </footer>
  </body>
</html>
